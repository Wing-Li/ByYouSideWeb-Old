NODE_ENV=development
PORT=38080

# PostgreSQL
# 本地开发和线上测试环境当前共用 Neon 的 dev 数据库；真实连接串写入 .env / .env.test，不提交仓库。
DATABASE_URL="postgresql://<user>:<password>@<neon-direct-host>/dev?channel_binding=require&sslmode=verify-full"

# Seed defaults. Replace these in local or production .env files.
ADMIN_USERNAME=admin
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>
APP_ENVIRONMENT=dev
APP_NAME=伴你左右
APP_UNCHECK_MODE=false

# Auth
JWT_SECRET=<jwt-secret>
JWT_EXPIRES_IN_SECONDS=31536000

# Mail
MAIL_MODE=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password-or-auth-code>
SMTP_FROM="伴你左右 <<smtp-user>>"

# Push
PUSH_MODE=umeng
UMENG_SEND_URL=https://msgapi.umeng.com/api/send
UMENG_TIMEOUT_MS=30000
UMENG_ANDROID_APP_KEY=<umeng-android-app-key>
UMENG_ANDROID_APP_MASTER_SECRET=<umeng-android-master-secret>
UMENG_IOS_APP_KEY=<umeng-ios-app-key>
UMENG_IOS_APP_MASTER_SECRET=<umeng-ios-master-secret>
