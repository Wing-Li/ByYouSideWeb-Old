NODE_ENV=development
PORT=3000

# PostgreSQL
# 本地开发和线上测试环境当前共用 Neon 的 dev 数据库；真实连接串写入 .env / .env.test，不提交仓库。
DATABASE_URL="postgresql://user:password@host/dev?channel_binding=require&sslmode=verify-full"

# Seed defaults. Replace these in local or production .env files.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_123456
APP_ENVIRONMENT=dev
APP_NAME=伴你左右
APP_UNCHECK_MODE=false

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=2592000

# Mail
MAIL_MODE=log

# Future phases will add real SMTP and push settings.
